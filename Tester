    "Lava Rock", "Electric", "Burn", "Instakill",
}

local function isDanger(name)
    local low = name:lower()
    for _, d in ipairs(DANGER) do
        if low:find(d:lower(), 1, true) then
            return true
        end
    end
    return false
end

-- ── GOD MODE: health stays at max every frame
-- This is what lets you walk on lava/spikes freely
-- Server damages you, we instantly restore it
RunService.Heartbeat:Connect(function()
    if not getChar() then return end

    -- god mode = lock health
    if S.god and hum then
        if hum.Health < hum.MaxHealth then
            pcall(function()
                hum.Health = hum.MaxHealth
            end)
        end
        -- also prevent knockback from damage tiles
        -- by keeping WalkSpeed and JumpPower normal
        pcall(function()
            if hum.WalkSpeed < 16 then
                hum.WalkSpeed = 16
            end
        end)
    end

    -- auto tele
    if S.tele and S.telePos then
        pcall(function()
            root.CFrame = CFrame.new(S.telePos)
        end)
    end
end)

-- ── Noclip
RunService.Stepped:Connect(function()
    if not S.noclip then return end
    if not getChar() then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
        end
    end
end)

